# Base URL of the WordPress site, without a trailing slash.
WP_URL=http://aj-ua.local

# Application Password credentials (Users > Profile > Application Passwords).
# Required for the editor and dev profiles; ignored by the public profile.
# Use a dedicated user with the Editor role. If Wordfence is active, turn off
# "Disable WordPress application passwords" (Wordfence > All Options > Brute Force Protection).
WP_USER=
WP_APP_PASSWORD=

# Tool profile:
#   public - read published content only (never signs in)
#   editor - adds draft-only editing tools and content_audit (needs credentials)
#   dev    - adds schemas, type generation, payload samples, and site checks (needs credentials)
MCP_PROFILE=public

# Cache lifetime for GET requests, in seconds. Use 0 to disable.
WP_CACHE_TTL=60

# Optional: absolute path to the theme's acf-json folder. Adds ACF field labels and
# full field schemas. Without it, field types come from the REST API schema.
# Example: /absolute/path/to/wp-content/themes/your-theme/acf-json
ACF_JSON_PATH=

# Custom post type tools: "auto" (one list_/get_ pair per custom post type), "none",
# or a JSON array to set names, e.g.
# [{"postType":"project","singular":"project","plural":"projects"}]
MCP_CPTS=auto

# Transport: "stdio" (local clients such as Claude Desktop/Code) or "http" (remote clients
# such as a PWA backend). See docs/PWA_BACKEND.md.
MCP_TRANSPORT=stdio

# HTTP mode only. The token is required (at least 32 characters): openssl rand -hex 32
MCP_HTTP_TOKEN=
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3333
# "true" keeps a session per client (Mcp-Session-Id); default is stateless.
MCP_HTTP_SESSIONS=false
MCP_HTTP_SESSION_IDLE_MINUTES=30
# Comma-separated browser origins allowed to call the server (CORS). Empty = server-to-server only.
MCP_HTTP_ALLOWED_ORIGINS=
